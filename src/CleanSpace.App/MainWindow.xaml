<Window
    x:Class="CleanSpace.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CleanSpace.App.Views"
    Title="CleanSpace">
    <Grid x:Name="ContentRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:Name="Navigation" PaneDisplayMode="Auto"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
                        PaneTitle="CleanSpace" SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="Dashboard" Icon="Home" IsSelected="{x:Bind ViewModel.IsDashboard, Mode=OneWay}" />
                <NavigationViewItem Content="Scan Results" Tag="ScanResults" Icon="Find" IsSelected="{x:Bind ViewModel.IsScanResults, Mode=OneWay}" />
                <NavigationViewItem Content="Cleanup (unavailable)" IsEnabled="False" Icon="ProtectedDocument"
                                    ToolTipService.ToolTip="Cleanup is unavailable in this read-only release." />
            </NavigationView.MenuItems>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="24" Spacing="24" MaxWidth="960" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                                   Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.PageDescription, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                             Title="Read-only analyzer"
                             Message="Quick Scan is temporarily unavailable. Drive information is available. Cleanup remains unavailable." />
                    <views:DashboardView ViewModel="{x:Bind ViewModel.Dashboard}" QuickScanCommand="{x:Bind ViewModel.QuickScanCommand}"
                                         Visibility="{x:Bind ViewModel.IsDashboard, Mode=OneWay}" />
                    <views:ScanResultsView ViewModel="{x:Bind ViewModel.Scan}"
                                           Visibility="{x:Bind ViewModel.IsScanResults, Mode=OneWay}" />
                    <views:SettingsView ViewModel="{x:Bind ViewModel.Settings}"
                                        Visibility="{x:Bind ViewModel.IsSettings, Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
