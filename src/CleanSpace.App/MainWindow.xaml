<Window
    x:Class="CleanSpace.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CleanSpace.App.Views"
    Title="CleanSpace">
    <Grid x:Name="ContentRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:Name="Navigation" PaneDisplayMode="Auto"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
                        PaneTitle="CleanSpace" SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="Dashboard" Icon="Home" IsSelected="True" />
                <NavigationViewItem Content="Scan Results" Tag="ScanResults" Icon="Find" />
                <NavigationViewItem Content="Cleanup (unavailable)" IsEnabled="False" Icon="ProtectedDocument"
                                    ToolTipService.ToolTip="Cleanup is unavailable in this read-only release." />
            </NavigationView.MenuItems>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="24" Spacing="24" MaxWidth="960" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                                   Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.PageDescription, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                             Title="Read-only overview"
                             Message="Scanning and cleanup are unavailable. CleanSpace has not analyzed or changed your files." />
                    <views:DashboardView ViewModel="{x:Bind ViewModel.Dashboard}"
                                         Visibility="{x:Bind ViewModel.IsDashboard, Mode=OneWay}" />
                    <Border Visibility="{x:Bind ViewModel.IsPlaceholder, Mode=OneWay}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="24">
                        <StackPanel Spacing="16">
                            <TextBlock Text="No scan results yet" TextWrapping="Wrap"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="No junk-file analysis has been performed. Scanning is unavailable in this release."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <views:SettingsView ViewModel="{x:Bind ViewModel.Settings}"
                                        Visibility="{x:Bind ViewModel.IsSettings, Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
