<UserControl
    x:Class="CleanSpace.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="16">
        <ComboBox Header="App theme" MinWidth="200" HorizontalAlignment="Left"
                  ItemsSource="{x:Bind ViewModel.ThemeOptions, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                  IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                  AutomationProperties.Name="App theme" />
        <Button Content="Apply theme" Command="{x:Bind ViewModel.SaveThemeCommand, Mode=OneWay}" />
        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
