<UserControl
    x:Class="CleanSpace.App.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="20">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Windows system drive" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.Identity, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock Text="{x:Bind ViewModel.FileSystem, Mode=OneWay}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" VerticalAlignment="Top"
                    Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}"
                    AutomationProperties.Name="Refresh drive information" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          AutomationProperties.Name="Loading drive information" />
            <TextBlock Text="Reading Windows drive information…" VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error"
                 Title="Drive information unavailable" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
            <StackPanel Spacing="20">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Total capacity" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.Total, Mode=OneWay}" TextWrapping="Wrap"
                                   Style="{ThemeResource SubtitleTextBlockStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.TotalExact, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="Used space" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.Used, Mode=OneWay}" TextWrapping="Wrap"
                                   Style="{ThemeResource SubtitleTextBlockStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.UsedExact, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="8">
                        <TextBlock Text="Free space (volume)" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.Free, Mode=OneWay}" TextWrapping="Wrap"
                                   Style="{ThemeResource SubtitleTextBlockStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.FreeExact, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.Percentage, Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.UsageValue, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.HasUsage, Mode=OneWay}"
                                 AutomationProperties.Name="Windows volume percentage used" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Available to you" />
                    <TextBlock Text="{x:Bind ViewModel.AvailableToUser, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{ThemeResource SubtitleTextBlockStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.AvailableExact, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.AvailabilityNotice, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.UpdatedStatus, Mode=OneWay}" TextWrapping="Wrap"
                           Style="{ThemeResource CaptionTextBlockStyle}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
        <TextBlock Text="No junk-file analysis has been performed yet. This overview reads volume metadata only; it does not inspect your files."
                   TextWrapping="Wrap" />
        <Button Content="Quick Scan" Command="{x:Bind QuickScanCommand, Mode=OneWay}"
                AutomationProperties.Name="Quick Scan" />
    </StackPanel>
</UserControl>
